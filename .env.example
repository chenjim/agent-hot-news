# Database (PostgreSQL + pgvector via Docker: docker compose up -d postgres)
DATABASE_URL=postgresql+psycopg2://hotnews:hotnews@localhost:51132/hotnews
REDIS_URL=redis://localhost:51179/0

# Tianapi (hot news data source)
TIANAPI_KEY=your_tianapi_key_here

# OpenAI (or other LLM provider)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_CHAT_MODEL=deepseek/deepseek-v4-flash

# OpenAI embedding model
# OPENAI_EMBEDDING_API_KEY=   # 可选：embedding 独立 Key，空则复用 OPENAI_API_KEY
# OPENAI_EMBEDDING_BASE_URL=  # 可选：embedding 独立地址，空则复用 OPENAI_BASE_URL
OPENAI_EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024

# Local LLM (optional, fallback)
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=qwen2.5:14b

# App
DEBUG=true
LOG_LEVEL=INFO

# API 访问令牌（留空 = 关闭鉴权，仅限本地开发）
#   READ_TOKEN  保护 GET 接口：/hot-events /articles /sources(GET) /admin(stats,logs) /sse
#   WRITE_TOKEN 保护写接口：/sources POST|PUT|DELETE、/sources/{id}/fetch、/admin/trigger-*
# 生成：openssl rand -hex 16
READ_TOKEN=
WRITE_TOKEN=

# 数据保留天数（超过则每日 00:00 清理）
CLEANUP_RETENTION_DAYS=5

# CORS（逗号分隔，空则用内置默认）
# CORS_ORIGINS=https://news.h89.cn

# 出站代理（容器内采集器 + LLM 调用；注释掉则 compose 用局域网默认）
# HTTP_PROXY=http://192.168.31.165:7890
# HTTPS_PROXY=http://192.168.31.165:7890

# Fetch intervals (random range, minutes)
FETCH_INTERVAL_DAY_MIN=30
FETCH_INTERVAL_DAY_MAX=60
FETCH_INTERVAL_NIGHT_MIN=60
FETCH_INTERVAL_NIGHT_MAX=120

# AI process interval (fixed, minutes)
AI_PROCESS_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_BATCH=500
